FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
# NOTE: fleet_mode.py is deliberately NOT baked in here. This image is the HOT-LOADER: it pulls
# work_item_runner.py from the lake on every request, and bootstrap.py pulls the matching
# fleet_mode.py from beside it on the same request. A copy baked in at build time would be the
# stale second copy the switch exists to avoid.
COPY bootstrap.py .
ENV PORT=8080
CMD exec gunicorn --bind :$PORT --workers 1 --threads 1 --timeout 3600 bootstrap:app
